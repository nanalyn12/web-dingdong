# === Database (필수) — Railway Postgres ===
# 로컬 개발: Railway 대시보드의 DATABASE_PUBLIC_URL 값 사용
# 프로덕션(Railway): ${{Postgres.DATABASE_URL}} 참조로 자동 주입
DATABASE_URL="postgresql://user:pass@host:5432/railway"

# === 인증 (필수) — better-auth ===
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
# 배포 도메인이 RAILWAY_PUBLIC_DOMAIN과 다를 때만 설정
# BETTER_AUTH_URL="https://example.com"

# Google 로그인 (선택) — Google Cloud Console에서 OAuth 클라이언트 생성
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 관리자/교사 자동 승격 이메일 목록 (쉼표 구분)
# 아이디 가입은 <아이디>@dingdong.local 형태의 이메일이 됩니다
ADMIN_EMAILS=""
TEACHER_EMAILS=""

# === 미디어 저장 (Suno 음원/영상, 레슨 이미지) ===
# Railway에서는 /data 볼륨 마운트 + MEDIA_DIR=/data/media
# 관리자별 데이터 백업 파일도 같은 볼륨의 <MEDIA_DIR>/../backups/tenants/ 아래에
# 저장됩니다(공개 /media/* 라우트 밖). 별도 환경변수는 필요 없지만, 볼륨이
# 마운트되어 있어야 백업이 재배포 후에도 남습니다.
MEDIA_DIR="./data/media"

# === AI 기능 (대본/드라마/레슨/이미지 생성, 가사 병음·번역) ===
# Google Generative Language API 키
GEMINI_API_KEY=""

# === 영상 스튜디오 ===
PEXELS_API_KEY=""
GOOGLE_TTS_API_KEY=""
# ffmpeg 바이너리 경로 (미설정 시 ffmpeg-static 사용)
# FFMPEG_PATH=""

# === 외부 API (선택) ===
# GEMINI_API_KEY·SUNO_API_KEY는 "플랫폼 공용 키"입니다. 사용자가 'AI 설정'에서
# 본인 키를 등록하면 그 사람의 호출은 개인 키로 나가고, 등록하지 않은 사람만
# 여기 설정된 공용 키를 씁니다.
SUNO_API_KEY=""
SUPADATA_API_KEY=""

# === 웹 푸시 알림 (선택) ===
# 생성: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:yu26he@gmail.com"

# 재참여 푸시 웹훅(/api/public/hooks/reengagement-push) 호출용 공유 시크릿
CRON_HOOK_SECRET=""
